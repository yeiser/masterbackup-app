# =========================================
# MasterBackup API - Environment Variables
# =========================================
# Copia este archivo a .env y configura tus valores
# Este archivo NO debe ser commiteado al repositorio

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Master Database Connection (REQUERIDO)
# PostgreSQL connection string para la base de datos principal que gestiona los tenants
MASTER_DATABASE_CONNECTION=Host=localhost;Port=5432;Database=master_saas;Username=postgres;Password=tu_password_aqui;Include Error Detail=true

# Serilog Database Connection (OPCIONAL)
# Si no se define, usa el mismo valor que MASTER_DATABASE_CONNECTION
# Puedes usar una base de datos diferente para logs si lo deseas
# MASTER_DATABASE_CONNECTION=Host=localhost;Port=5432;Database=master_saas;Username=postgres;Password=tu_password_aqui;Include Error Detail=true

# =============================================================================
# AZURE BLOB STORAGE CONFIGURATION
# =============================================================================

# Azure Storage Connection String (REQUERIDO)
# Para desarrollo local: usa el emulador de Azure Storage
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Para producción: obtén el connection string desde Azure Portal
# Azure Portal > Storage Account > Access Keys > Connection string
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account_name>;AccountKey=<account_key>;EndpointSuffix=core.windows.net

# =============================================================================
# RABBITMQ CONFIGURATION (Opcional - puede usar appsettings.json)
# =============================================================================

# RABBITMQ__HOSTNAME=localhost
# RABBITMQ__PORT=5672
# RABBITMQ__USERNAME=guest
# RABBITMQ__PASSWORD=guest
# RABBITMQ__VIRTUALHOST=/

# =============================================================================
# JWT CONFIGURATION (Opcional - puede usar appsettings.json)
# =============================================================================

# JWT__KEY=your-secure-jwt-key-minimum-32-characters-long-here
# JWT__ISSUER=MasterBackupAPI
# JWT__AUDIENCE=MasterBackupClient

# =============================================================================
# ENCRYPTION CONFIGURATION (Opcional - puede usar appsettings.json)
# =============================================================================

# ENCRYPTION__KEY=your-secure-encryption-key-minimum-32-characters

# =============================================================================
# MAILEROO EMAIL SERVICE (Opcional - puede usar appsettings.json)
# =============================================================================

# MAILEROO__APIKEY=your-maileroo-api-key
# MAILEROO__FROMEMAIL=notifications@yourdomain.com
# MAILEROO__FROMNAME=MasterBackup

# =============================================================================
# APPLICATION URL (Opcional - puede usar appsettings.json)
# =============================================================================

# APPURL=http://localhost:4200

# =============================================================================
# NOTAS
# =============================================================================
# - Las variables de entorno tienen precedencia sobre appsettings.json
# - MASTER_DATABASE_CONNECTION y AZURE_STORAGE_CONNECTION_STRING son REQUERIDAS
# - En producción, usa SSL Mode=Require para conexiones de base de datos seguras
# - Para Docker deployments, usa docker-compose.yml o Kubernetes secrets
# - Nunca expongas claves o contraseñas en el código fuente o repositorio
