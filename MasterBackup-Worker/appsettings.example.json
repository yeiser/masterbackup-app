{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Worker": {
    "WorkerName": "Worker-Production-01",
    "ApiKey": "REPLACE_WITH_YOUR_API_KEY",
    "Tags": ["production", "postgresql", "americas"],
    "SupportedDatabaseTypes": ["PostgreSQL"],
    "MaxConcurrentJobs": 3
  },
  "Api": {
    "BaseUrl": "https://api.masterbackup.com"
  },
  "DatabaseTools": {
    "PostgreSQL": {
      "PgDumpPath": "/usr/bin/pg_dump",
      "PgRestorePath": "/usr/bin/pg_restore"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
