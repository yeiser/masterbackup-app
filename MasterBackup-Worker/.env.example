# ===== CONFIGURACIÓN REQUERIDA =====

# API Base URL (provided by MasterBackup administrator)
API_BASE_URL=https://api.masterbackup.com

# Worker API Key (generated from MasterBackup admin panel)
WORKER_API_KEY=your-api-key-here

# ===== CONFIGURACIÓN OPCIONAL =====

# Worker identification name
WORKER_NAME=Worker-YourCompany-01

# Worker tags for organization (JSON array format)
WORKER_TAGS=["production", "postgresql"]

# Maximum concurrent backup jobs
MAX_CONCURRENT_JOBS=3
